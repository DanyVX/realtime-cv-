# Optional authentication key for the inference API. Leave unset to disable API-key auth.
RCS_API_KEY=
# Model artifact path. The file is never committed; provide it at deployment time.
RCS_MODEL_PATH=
# Maximum accepted request payload, in bytes.
RCS_MAX_UPLOAD_BYTES=10485760
# Maximum decoded image pixels, to guard against decompression bombs.
RCS_MAX_IMAGE_PIXELS=40000000
# Dynamic-batching queue capacity.
RCS_QUEUE_CAPACITY=128
